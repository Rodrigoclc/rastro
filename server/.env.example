# Domínios (crie registros DNS do tipo A apontando para este servidor)
OTEL_DOMAIN=otel.example.com
GRAFANA_DOMAIN=grafana.example.com
ACME_EMAIL=voce@example.com

# Um token por ambiente. Gere com: openssl rand -hex 32
OTEL_TOKEN_PRODUCTION=
OTEL_TOKEN_STAGING=

# Login inicial do Grafana (só vale na primeira subida)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Retenção de métricas no Prometheus
METRICS_RETENTION=30d
