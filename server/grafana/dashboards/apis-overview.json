    {
      "id": 10,
      "type": "table",
      "title": "Rotas (período selecionado)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ordene pelas colunas para achar as rotas mais lentas ou com mais erro.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, http_route) (increase(http_server_request_duration_seconds_count{deployment_environment_name=\"$env\", service_name=~\"$service\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (service_name, http_route) (increase(http_server_request_duration_seconds_count{deployment_environment_name=\"$env\", service_name=~\"$service\", http_response_status_code=~\"5..\"}[$__range])) or 0 * sum by (service_name, http_route) (increase(http_server_request_duration_seconds_count{deployment_environment_name=\"$env\", service_name=~\"$service\"}[$__range]))) / sum by (service_name, http_route) (increase(http_server_request_duration_seconds_count{deployment_environment_name=\"$env\", service_name=~\"$service\"}[$__range]))",
          "refId": "B",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name, http_route) (increase(http_server_request_duration_seconds_bucket{deployment_environment_name=\"$env\", service_name=~\"$service\"}[$__range])))",
          "refId": "C",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "Serviço",
              "http_route": "Rota",
              "Value #A": "Requisições",
              "Value #B": "Erro 5xx",
              "Value #C": "p95"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p95",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
