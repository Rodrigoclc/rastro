{
  "name": "rastro",
  "version": "0.1.0",
  "description": "Observabilidade OpenTelemetry pronta para APIs AdonisJS 5, 6 e 7: traces, logs e métricas com uma linha no PM2.",
  "license": "MIT",
  "author": "Rodrigo Castro (https://orodrigodev.com.br)",
  "homepage": "https://github.com/Rodrigoclc/rastro#readme",
  "bugs": "https://github.com/Rodrigoclc/rastro/issues",
  "keywords": [
    "adonisjs",
    "adonis",
    "opentelemetry",
    "otel",
    "observability",
    "observabilidade",
    "tracing",
    "metrics",
    "logs",
    "grafana",
    "pm2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rodrigoclc/rastro.git",
    "directory": "packages/rastro"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./register": {
      "import": "./dist/register.js",
      "require": "./dist/register.cjs"
    },
    "./adonis": {
      "import": "./dist/adonis.js",
      "require": "./dist/adonis.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepublishOnly": "tsup"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/api-logs": "0.223.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.1",
    "@opentelemetry/host-metrics": "0.39.0",
    "@opentelemetry/instrumentation": "0.223.1",
    "@opentelemetry/instrumentation-http": "0.223.1",
    "@opentelemetry/instrumentation-mysql2": "0.69.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "@opentelemetry/instrumentation-runtime-node": "0.36.1",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-logs": "0.223.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-node": "0.223.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/semantic-conventions": "^1.36.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "tsup": "8.5.1",
    "typescript": "~5.9.3"
  }
}
